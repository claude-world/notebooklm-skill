# Optional notebooklm-skill settings. Copy to .env.
# Authentication cookies do not belong in this file.

# Select an auth profile created with: notebooklm-auth --profile work setup
# NOTEBOOKLM_PROFILE=work

# Optional custom configuration root (default: ~/.notebooklm)
# NOTEBOOKLM_HOME=/absolute/private/path

# Optional executable used by trend-to-content / nlm_trend_research.
# The value is parsed as argv and never passed to a shell.
# TREND_PULSE_CMD=/absolute/path/to/trend-pulse
